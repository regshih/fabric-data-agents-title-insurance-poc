{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "keyVaultOfficerPrincipalId": { "value": "${KEY_VAULT_OFFICER_PRINCIPAL_ID}" },
    "entraClientId": { "value": "${ENTRA_CLIENT_ID}" },
    "fabricWorkspaceId": { "value": "${FABRIC_WORKSPACE_ID}" },
    "fabricDirectAgentId": { "value": "${FABRIC_DIRECT_AGENT_ID}" },
    "fabricOntologyAgentId": { "value": "${FABRIC_ONTOLOGY_AGENT_ID}" },
    "fabricSemanticAgentId": { "value": "${FABRIC_SEMANTIC_AGENT_ID}" },
    "fabricHybridAgentId": { "value": "${FABRIC_HYBRID_AGENT_ID}" }
  }
}
